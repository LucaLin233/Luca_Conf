#!name=AWS Lightsail 流量信息
#!desc=展示实例当月流量、配额占比与中文地区；支持多区域、多实例与用量提醒
#!category=Function

#!arguments=ak,sk,region:ap-northeast-1,query-interval:21600,notify-percent:80,ip-mode:mask,icon:cloud,icon-color:FF9900
#!arguments-desc=官网: aws.amazon.com/lightsail\n\nIAM 密钥获取方式:\n    ├ 1. AWS 控制台 → IAM → 策略 → 创建策略\n    ├ 2. 粘贴只读策略 JSON（lightsail:GetInstances / GetBundles / GetInstanceMetricData）\n    ├ 3. 创建用户并附加该策略\n    └ 4. 安全凭证 → 创建访问密钥\n区域:\n    ├ 默认 ap-northeast-1（东京）\n    └ 多个用英文逗号分隔，例: ap-northeast-1,us-east-1\n查询间隔（秒）:\n    ├ 默认 21600（6 小时）\n    ├ 3600 = 1 小时\n    └ 86400 = 1 天\n提醒阈值（%）:\n    ├ 默认用量达到 80% 时提醒\n    └ 填 0 关闭提醒；启用后每组每天最多提醒一次\nIP 显示模式:\n    ├ full\n    ├ mask\n    └ hide

[Panel]
Lightsail 流量信息 = title="AWS Lightsail",content="正在获取...",style=info,script-name=lightsail-traffic-panel,update-interval={{{query-interval}}}

[Script]
lightsail-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/lightsail_traffic.js,timeout=60,argument="ak={{{ak}}}&sk={{{sk}}}&region={{{region}}}&notify-percent={{{notify-percent}}}&ip-mode={{{ip-mode}}}&icon={{{icon}}}&icon-color={{{icon-color}}}"
