#!name=AWS Lightsail 流量信息
#!desc=展示实例当月流量、配额占比与中文地区；支持多区域、多实例、用量提醒与每日日报
#!category=Function

#!arguments=lightsail_ak,lightsail_sk,lightsail_region:ap-east-1|ap-northeast-1,lightsail_query_interval:21600,lightsail_notify_percent:80,lightsail_ip_mode:mask,lightsail_icon:cloud,lightsail_icon_color:FF9900,lightsail_daily_notify:true
#!arguments-desc=官网: aws.amazon.com/lightsail\n\nIAM 密钥获取方式:\n    ├ 1. AWS 控制台 → IAM → 策略 → 创建策略\n    ├ 2. 粘贴只读策略 JSON（lightsail:GetInstances / GetBundles / GetInstanceMetricData）\n    ├ 3. 创建用户并附加该策略\n    └ 4. 安全凭证 → 创建访问密钥\n区域:\n    ├ 默认 ap-east-1|ap-northeast-1（香港、东京）\n    └ 多个用竖线或英文逗号分隔（模块参数以逗号分隔参数名，故默认值用竖线）\n查询间隔（秒）:\n    ├ 默认 21600（6 小时）\n    ├ 3600 = 1 小时\n    └ 86400 = 1 天\n提醒阈值（%）:\n    ├ 默认用量达到 80% 时提醒\n    └ 填 0 关闭提醒；启用后每组每天最多提醒一次\nIP 显示模式:\n    ├ full\n    ├ mask\n    └ hide\n每日日报:\n    ├ 默认开启，每天 23:55 播报当月与今日流量\n    └ false 关闭

[Panel]
Lightsail 流量信息 = title="AWS Lightsail",content="正在获取...",style=info,script-name=lightsail-traffic-panel,update-interval={{{lightsail_query_interval}}}

[Script]
lightsail-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/lightsail_traffic.js,timeout=60,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&notify-percent={{{lightsail_notify_percent}}}&ip-mode={{{lightsail_ip_mode}}}&icon={{{lightsail_icon}}}&icon-color={{{lightsail_icon_color}}}"
lightsail-traffic-daily = type=cron,cronexp="55 23 * * *",wake-system=true,timeout=60,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/lightsail_traffic.js,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&ip-mode={{{lightsail_ip_mode}}}&daily-notify={{{lightsail_daily_notify}}}&mode=daily"
