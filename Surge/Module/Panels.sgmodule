#!name=Panels
#!desc=面板项目：Surge 功能开关检测、Peekabo 流量信息、CCH 配额与调用监控
#!category=System

#!arguments=id,token,query-interval:86400,notify-days:3,icon:xserve,icon-color:3B82F6,cch_url,cch_admin_token,cch_query_interval:60,cch_quota_interval:300,cch_icon:chart.bar.fill,cch_icon_color:34C759
#!arguments-desc=Peekabo 官网: gigo.peekabo.io\n\nServer ID:\n    └ 控制面板服务器页面 URL 中“/server/”后的内容\nAPI Token:\n    └ Account → API\n查询间隔（秒）:\n    ├ 默认 86400（每天一次）\n    ├ 43200 = 12 小时\n    └ 172800 = 2 天\n通知天数:\n    ├ 默认到期前 3 天开始通知\n    └ 填 0 关闭通知；启用后每天最多通知一次\n\nCCH 地址:\n    └ 必填，请输入 CCH HTTPS 地址，请勿添加末尾“/”\nCCH 管理员 Token:\n    └ 使用 ADMIN_TOKEN；仅保存在 Surge 本地模块参数中\nCCH 面板刷新间隔（秒）:\n    └ 默认 60\nCCH 额度刷新间隔（秒）:\n    └ 默认 300，期间使用本地缓存

[Panel]
# 功能检测
functionstatus = script-name=functionstatus,title=Surge,content=请刷新,update-interval=60

# Peekabo 流量信息
Peekabo 流量信息 = title="Peekabo Server",content="正在获取...",style=info,script-name=peekabo-traffic-panel,update-interval={{{query-interval}}}

# CCH 配额与调用监控
CCH 配额与监控 = title="CCH",content="正在获取...",style=info,script-name=cch-monitor-panel,update-interval={{{cch_query_interval}}}

[Script]
# 功能检测
functionstatus = type=generic,script-path=https://raw.githubusercontent.com/smartmimi/conf/master/surge/functionstatus.js

# Peekabo 流量信息
peekabo-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/peekabo_traffic.js,argument="id={{{id}}}&token={{{token}}}&notify-days={{{notify-days}}}&icon={{{icon}}}&icon-color={{{icon-color}}}"

# CCH 配额与调用监控
cch-monitor-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/cch_monitor.js,timeout=30,argument="cch_url={{{cch_url}}}&cch_admin_token={{{cch_admin_token}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_icon={{{cch_icon}}}&cch_icon_color={{{cch_icon_color}}}"
