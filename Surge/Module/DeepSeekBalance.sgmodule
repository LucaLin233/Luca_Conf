#!name=DeepSeek 余额信息
#!desc=展示 DeepSeek API 账户余额、赠送金额与查询时间；支持自定义查询间隔、低余额提醒和每日日报
#!category=System

#!arguments=deepseek_key,deepseek_query_interval:3600,deepseek_notify_balance:10,deepseek_warn_balance:5,deepseek_daily_notify:true,deepseek_icon:yensign.circle,deepseek_icon_color:4D6BFE
#!arguments-desc=官网: platform.deepseek.com\n\nAPI Key:\n    ├ 平台 → API keys → 创建 API key\n    └ 仅保存在 Surge 本地模块参数中，不会上传\n查询间隔（秒）:\n    ├ 默认 3600（1 小时）\n    ├ 300 = 5 分钟\n    └ 86400 = 1 天\n提醒阈值:\n    ├ 默认余额低于 10 时提醒\n    └ 填 0 关闭提醒；启用后每个币种每天最多提醒一次\n面板提示阈值:\n    ├ 默认余额低于 5 时在面板追加充值提示\n    └ 填 0 关闭提示\n每日日报:\n    ├ 默认开启，每天 23:50 播报余额\n    └ false 关闭\n图标与颜色:\n    └ 使用 SF Symbol 名称和六位 HEX 颜色

[Panel]
DeepSeek 余额信息 = title="DeepSeek",content="正在获取...",style=info,script-name=deepseek-balance-panel,update-interval={{{deepseek_query_interval}}}

[Script]
deepseek-balance-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/deepseek_balance.js,timeout=30,argument="deepseek_key={{{deepseek_key}}}&deepseek_notify_balance={{{deepseek_notify_balance}}}&deepseek_warn_balance={{{deepseek_warn_balance}}}&deepseek_icon={{{deepseek_icon}}}&deepseek_icon_color={{{deepseek_icon_color}}}"
deepseek-balance-daily = type=cron,cronexp="50 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Luca_Conf/main/Surge/JS/deepseek_balance.js,argument="deepseek_key={{{deepseek_key}}}&deepseek_daily_notify={{{deepseek_daily_notify}}}&mode=daily"
