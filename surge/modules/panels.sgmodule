#!name=Panels
#!desc=面板项目：Surge 功能开关检测、DeepSeek 余额、CCH 配额与调用监控、AWS Lightsail 流量、Peekabo 流量信息
#!category=System

#!arguments=lightsail_ak,lightsail_sk,lightsail_region:ap-east-1|ap-northeast-1,lightsail_query_interval:21600,lightsail_notify_percent:80,lightsail_ip_mode:mask,lightsail_icon:cloud,lightsail_icon_color:FF9900,lightsail_daily_notify:true,peekabo_id,peekabo_token,peekabo_query_interval:86400,peekabo_notify_days:3,peekabo_icon:xserve,peekabo_icon_color:3B82F6,deepseek_key,deepseek_query_interval:3600,deepseek_notify_balance:5,deepseek_warn_balance:5,deepseek_daily_notify:true,deepseek_icon:yensign.circle,deepseek_icon_color:4D6BFE,cch_url,cch_admin_token,cch_query_interval:60,cch_quota_interval:300,cch_icon:chart.bar.fill,cch_icon_color:34C759
#!arguments-desc=AWS Lightsail 官网: aws.amazon.com/lightsail\n\nIAM 密钥获取方式:\n    ├ 1. AWS 控制台 → IAM → 策略 → 创建策略\n    ├ 2. 粘贴只读策略 JSON（lightsail:GetInstances / GetBundles / GetInstanceMetricData）\n    ├ 3. 创建用户并附加该策略\n    └ 4. 安全凭证 → 创建访问密钥\n区域:\n    ├ 默认 ap-east-1|ap-northeast-1（香港、东京）\n    └ 多个用竖线或英文逗号分隔（模块参数以逗号分隔参数名，故默认值用竖线）\n查询间隔（秒）:\n    ├ 默认 21600（6 小时）\n    ├ 3600 = 1 小时\n    └ 86400 = 1 天\n提醒阈值（%）:\n    ├ 默认用量达到 80% 时提醒\n    └ 填 0 关闭提醒；启用后每组每天最多提醒一次\nIP 显示模式:\n    ├ full\n    ├ mask\n    └ hide\n每日日报:\n    ├ 默认开启，每天 23:55 播报当月与今日流量\n    └ false 关闭\n\nPeekabo 官网: gigo.peekabo.io\n\nServer ID:\n    └ 控制面板服务器页面 URL 中“/server/”后的内容\nAPI Token:\n    └ Account → API\n查询间隔（秒）:\n    ├ 默认 86400（每天一次）\n    ├ 43200 = 12 小时\n    └ 172800 = 2 天\n通知天数:\n    ├ 默认到期前 3 天开始通知\n    └ 填 0 关闭通知；启用后每天最多通知一次\n\nDeepSeek 官网: platform.deepseek.com\n\nAPI Key:\n    ├ 平台 → API keys → 创建 API key\n    └ 仅保存在 Surge 本地模块参数中，不会上传\n查询间隔（秒）:\n    ├ 默认 3600（1 小时）\n    ├ 300 = 5 分钟\n    └ 86400 = 1 天\n提醒阈值:\n    ├ 默认余额低于 5 时提醒\n    └ 填 0 关闭提醒；启用后每个币种每天最多提醒一次\n面板提示阈值:\n    ├ 默认余额低于 5 时在面板追加充值提示\n    └ 填 0 关闭提示\n每日日报:\n    ├ 默认开启，每天 23:50 播报余额\n    └ false 关闭\n\nCCH 地址:\n    └ 必填，请输入 CCH HTTPS 地址，请勿添加末尾“/”\nCCH 管理员 Token:\n    └ 使用 ADMIN_TOKEN；仅保存在 Surge 本地模块参数中\nCCH 面板刷新间隔（秒）:\n    └ 默认 60\nCCH 额度刷新间隔（秒）:\n    └ 默认 300，期间使用本地缓存

[Panel]
# 功能检测
functionstatus = script-name=functionstatus,title=Surge,content=请刷新,update-interval=60

# DeepSeek 余额信息
DeepSeek 余额信息 = title="DeepSeek",content="正在获取...",style=info,script-name=deepseek-balance-panel,update-interval={{{deepseek_query_interval}}}

# CCH 配额与调用监控
CCH 配额与监控 = title="CCH",content="正在获取...",style=info,script-name=cch-monitor-panel,update-interval={{{cch_query_interval}}}

# AWS Lightsail 流量信息
Lightsail 流量信息 = title="AWS Lightsail",content="正在获取...",style=info,script-name=lightsail-traffic-panel,update-interval={{{lightsail_query_interval}}}

# Peekabo 流量信息
Peekabo 流量信息 = title="Peekabo Server",content="正在获取...",style=info,script-name=peekabo-traffic-panel,update-interval={{{peekabo_query_interval}}}
[Script]
# 功能检测
functionstatus = type=generic,script-path=https://raw.githubusercontent.com/smartmimi/conf/master/surge/functionstatus.js

# DeepSeek 余额信息
deepseek-balance-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/deepseek_balance.js,timeout=30,argument="deepseek_key={{{deepseek_key}}}&deepseek_notify_balance={{{deepseek_notify_balance}}}&deepseek_warn_balance={{{deepseek_warn_balance}}}&deepseek_icon={{{deepseek_icon}}}&deepseek_icon_color={{{deepseek_icon_color}}}"
deepseek-balance-daily = type=cron,cronexp="50 23 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/deepseek_balance.js,argument="deepseek_key={{{deepseek_key}}}&deepseek_daily_notify={{{deepseek_daily_notify}}}&mode=daily"

# CCH 配额与调用监控
cch-monitor-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/cch_monitor.js,timeout=30,argument="cch_url={{{cch_url}}}&cch_admin_token={{{cch_admin_token}}}&cch_quota_interval={{{cch_quota_interval}}}&cch_icon={{{cch_icon}}}&cch_icon_color={{{cch_icon_color}}}"

# AWS Lightsail 流量信息
lightsail-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/lightsail_traffic.js,timeout=60,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&notify-percent={{{lightsail_notify_percent}}}&ip-mode={{{lightsail_ip_mode}}}&icon={{{lightsail_icon}}}&icon-color={{{lightsail_icon_color}}}"
lightsail-traffic-daily = type=cron,cronexp="55 23 * * *",wake-system=true,timeout=60,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/lightsail_traffic.js,argument="ak={{{lightsail_ak}}}&sk={{{lightsail_sk}}}&region={{{lightsail_region}}}&ip-mode={{{lightsail_ip_mode}}}&daily-notify={{{lightsail_daily_notify}}}&mode=daily"

# Peekabo 流量信息
peekabo-traffic-panel = type=generic,script-path=https://raw.githubusercontent.com/LucaLin233/Proxy/main/surge/scripts/peekabo_traffic.js,argument="id={{{peekabo_id}}}&token={{{peekabo_token}}}&notify-days={{{peekabo_notify_days}}}&icon={{{peekabo_icon}}}&icon-color={{{peekabo_icon_color}}}"
